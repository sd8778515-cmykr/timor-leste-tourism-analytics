# Copy this file to .env and fill in your real key. Never commit .env to git.

# Apify -> Personal API token (fonte TUNGGAL: destinasaun + review)
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_ACTOR_ID=compass/crawler-google-places

# Flask dashboard
FLASK_SECRET_KEY=dev-secret-change-me
FLASK_ENV=development
FLASK_PORT=5000

# Collection settings
COLLECTION_POLL_INTERVAL_HOURS=24
